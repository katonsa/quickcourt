# QuickCourt local environment variables
#
# Next.js manages NODE_ENV automatically. Use APP_ENV for deployment stage:
# development, test, staging, or production.

# App
APP_ENV=development
APP_URL=http://localhost:3000
# Allowed: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# Client-safe public values. Only NEXT_PUBLIC_* variables may be imported by
# Client Components through config/public-env.ts. Never place secrets here.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickcourt
# Optional canonical test database URL. Must not point to the same database as DATABASE_URL.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/quickcourt_test

# Better Auth
# Must be at least 32 characters.
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional. User must already exist through Better Auth before promotion.
ADMIN_BOOTSTRAP_EMAIL=

# Email
#
# Development and test can use EMAIL_PROVIDER=console without Resend config.
# Staging and production require RESEND_API_KEY and EMAIL_FROM.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=
