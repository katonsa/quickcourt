// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// Enums Domain App
// ------------------------------------------------------------

enum UserStatus {
  active
  suspended
  banned
  deleted
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum VenueStatus {
  draft
  pending_approval
  approved
  rejected
  suspended
  banned
  closed
}

enum VerificationStatus {
  unverified
  verified
  rejected
}

enum BranchStatus {
  active
  inactive
  suspended
  closed
}

enum IndoorOutdoor {
  indoor
  outdoor
  semi_indoor
}

enum CourtStatus {
  active
  inactive
  maintenance
  deleted
}

enum PriceRuleType {
  weekday
  weekend
  peak_hour
  custom
}

enum AvailabilityBlockStatus {
  active
  cancelled
}

enum AvailabilityBlockType {
  maintenance
  event
  reserved
  closed
}

enum BookingSource {
  online
  walk_in
  admin_created
}

enum BookingStatus {
  pending_payment
  confirmed
  completed
  cancelled
  no_show
  expired
}

enum BookingPaymentStatus {
  unpaid
  pending
  paid
  failed
  expired
  refunded
  partially_refunded
}

enum BookingSlotStatus {
  pending
  confirmed
  completed
  cancelled
  no_show
}

enum CancellationActorType {
  customer
  venue_owner
  venue_staff
  super_admin
  system
}

enum CancellationStatus {
  requested
  processed
  rejected
}

enum CheckInMethod {
  qr
  manual
}

enum PaymentGateway {
  xendit
}

enum PaymentMethod {
  qris
  bank_transfer
  credit_card
  debit_card
  ewallet
  retail_outlet
  other
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  cancelled
  refunded
  partially_refunded
}

enum WebhookProcessingStatus {
  pending
  processed
  failed
  ignored
}

enum RefundStatus {
  pending
  processing
  succeeded
  failed
  cancelled
}

enum LedgerEntryType {
  booking_gross_credit
  platform_commission_debit
  gateway_fee_debit
  refund_debit
  withdrawal_debit
  withdrawal_fee_debit
  manual_adjustment_credit
  manual_adjustment_debit
}

enum LedgerEntryStatus {
  pending
  available
  settled
  cancelled
}

enum WithdrawalStatus {
  requested
  approved
  processing
  paid
  rejected
  failed
  cancelled
}

enum InvoiceStatus {
  draft
  issued
  paid
  cancelled
  refunded
}

enum ReviewStatus {
  published
  hidden
  reported
  deleted
}

enum NotificationChannel {
  email
  whatsapp
}

enum NotificationType {
  booking_confirmation
  booking_reminder
  booking_cancelled
  payment_success
  payment_failed
  refund_processed
  staff_invitation
  venue_approval
  withdrawal_update
}

enum NotificationStatus {
  pending
  sent
  failed
  cancelled
}

enum ReminderType {
  before_booking
}

enum ReminderStatus {
  scheduled
  sent
  failed
  cancelled
}

enum ApprovalRequestStatus {
  pending
  approved
  rejected
}

enum SuspensionStatus {
  active
  expired
  revoked
}

// ------------------------------------------------------------
// 1. Better Auth Core + Admin Plugin + Organization Plugin
// Generated by Better Auth CLI, lalu ditambahkan relation ke domain app.
// ------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @db.Citext
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth Admin plugin
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Better Auth relations
  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  // App profile extension
  profile UserProfile?

  // App relations
  approvedVenues  Venue[] @relation("VenueApprovedBy")
  suspendedVenues Venue[] @relation("VenueSuspendedBy")

  availabilityBlocksCreated CourtAvailabilityBlock[] @relation("AvailabilityBlockCreatedBy")

  customerBookings              Booking[]             @relation("CustomerBookings")
  bookingsCancelled             Booking[]             @relation("BookingCancelledBy")
  bookingsCreated               Booking[]             @relation("BookingCreatedBy")
  bookingCancellationsRequested BookingCancellation[] @relation("BookingCancellationRequestedBy")
  checkInsCustomer              BookingCheckIn[]      @relation("CheckInCustomer")
  checkInsStaff                 BookingCheckIn[]      @relation("CheckInStaff")

  payments         Payment[] @relation("PaymentCustomer")
  refundsCustomer  Refund[]  @relation("RefundCustomer")
  refundsRequested Refund[]  @relation("RefundRequestedBy")

  withdrawalsRequested Withdrawal[] @relation("WithdrawalRequestedBy")
  withdrawalsProcessed Withdrawal[] @relation("WithdrawalProcessedBy")

  invoices      Invoice[] @relation("InvoiceCustomer")
  reviews       Review[]  @relation("ReviewCustomer")
  reviewsHidden Review[]  @relation("ReviewHiddenBy")

  notificationLogs NotificationLog[] @relation("NotificationUser")
  bookingReminders BookingReminder[] @relation("ReminderCustomer")

  venueApprovalSubmitted VenueApprovalRequest[] @relation("ApprovalSubmittedBy")
  venueApprovalReviewed  VenueApprovalRequest[] @relation("ApprovalReviewedBy")

  userSuspensionsReceived UserSuspension[] @relation("UserSuspended")
  userSuspensionsCreated  UserSuspension[] @relation("UserSuspendedBy")
  userSuspensionsRevoked  UserSuspension[] @relation("UserSuspensionRevokedBy")

  venueSuspensionsCreated VenueSuspension[] @relation("VenueSuspensionSuspendedBy")
  venueSuspensionsRevoked VenueSuspension[] @relation("VenueSuspensionRevokedBy")

  platformSettingsUpdated PlatformSetting[] @relation("PlatformSettingUpdatedBy")
  auditLogs               AuditLog[]        @relation("AuditActor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Better Auth Admin plugin
  impersonatedBy String?

  // Better Auth Organization plugin
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  // App relation: 1 organization = 1 venue/business account untuk MVP.
  venue Venue?

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  // App extension untuk staff yang hanya boleh akses branch tertentu.
  branchAccess MemberBranchAccess[]

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ------------------------------------------------------------
// 2. User Profile Extension
// ------------------------------------------------------------

model UserProfile {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber   String?   @map("phone_number")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        Gender?

  status      UserStatus @default(active)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phoneNumber])
  @@index([status])
  @@map("user_profiles")
}

// ------------------------------------------------------------
// 3. Master Data
// ------------------------------------------------------------

model Sport {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  iconUrl   String?  @map("icon_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venueSports VenueSport[]
  courts      Court[]

  @@index([isActive])
  @@map("sports")
}

model City {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provinceName String   @map("province_name")
  cityName     String   @map("city_name")
  slug         String   @unique
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches VenueBranch[]

  @@index([provinceName])
  @@index([isActive])
  @@map("cities")
}

model Facility {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  iconUrl   String?  @map("icon_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venueFacilities VenueFacility[]

  @@index([isActive])
  @@map("facilities")
}

// ------------------------------------------------------------
// 4. Venue, Branch, Staff Access
// ------------------------------------------------------------

model Venue {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Better Auth Organization sebagai boundary akses owner/staff.
  organizationId String       @unique @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name              String
  slug              String  @unique
  description       String?
  legalBusinessName String? @map("legal_business_name")
  taxNumber         String? @map("tax_number")

  status               VenueStatus        @default(draft)
  verificationStatus   VerificationStatus @default(unverified) @map("verification_status")
  defaultCommissionBps Int?               @map("default_commission_bps")
  averageRating        Decimal            @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount          Int                @default(0) @map("review_count")

  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  approvedByUserId String?   @map("approved_by_user_id")
  approvedBy       User?     @relation("VenueApprovedBy", fields: [approvedByUserId], references: [id])

  suspendedAt       DateTime? @map("suspended_at") @db.Timestamptz(6)
  suspendedByUserId String?   @map("suspended_by_user_id")
  suspendedBy       User?     @relation("VenueSuspendedBy", fields: [suspendedByUserId], references: [id])
  suspensionReason  String?   @map("suspension_reason")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches         VenueBranch[]
  venueSports      VenueSport[]
  venueFacilities  VenueFacility[]
  photos           VenuePhoto[]
  bankAccounts     VenueBankAccount[]
  courts           Court[]
  bookings         Booking[]
  ledgerEntries    VenueLedgerEntry[]
  withdrawals      Withdrawal[]
  invoices         Invoice[]
  reviews          Review[]
  approvalRequests VenueApprovalRequest[]
  suspensions      VenueSuspension[]

  @@index([organizationId])
  @@index([status])
  @@index([verificationStatus])
  @@index([averageRating])
  @@map("venues")
}

model VenueBranch {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId String @map("venue_id") @db.Uuid
  cityId  String @map("city_id") @db.Uuid

  name               String
  address            String
  latitude           Decimal?     @db.Decimal(10, 7)
  longitude          Decimal?     @db.Decimal(10, 7)
  googleMapsPlaceId  String?      @map("google_maps_place_id")
  googleMapsEmbedUrl String?      @map("google_maps_embed_url")
  timezone           String       @default("Asia/Jakarta")
  phoneNumber        String?      @map("phone_number")
  email              String?
  isDefault          Boolean      @default(false) @map("is_default")
  status             BranchStatus @default(active)
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  city  City  @relation(fields: [cityId], references: [id])

  photos             VenuePhoto[]
  courts             Court[]
  bookings           Booking[]
  ledgerEntries      VenueLedgerEntry[]
  reviews            Review[]
  memberBranchAccess MemberBranchAccess[]

  @@index([venueId])
  @@index([cityId])
  @@index([status])
  @@index([latitude, longitude])
  @@map("venue_branches")
}

model VenueSport {
  venueId   String   @map("venue_id") @db.Uuid
  sportId   String   @map("sport_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([venueId, sportId])
  @@index([sportId])
  @@map("venue_sports")
}

model VenueFacility {
  venueId    String   @map("venue_id") @db.Uuid
  facilityId String   @map("facility_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  venue    Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([venueId, facilityId])
  @@map("venue_facilities")
}

model VenuePhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  venue  Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  branch VenueBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([branchId])
  @@map("venue_photos")
}

model VenueBankAccount {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId            String    @map("venue_id") @db.Uuid
  bankName           String    @map("bank_name")
  bankCode           String?   @map("bank_code")
  accountNumber      String    @map("account_number")
  accountNumberLast4 String?   @map("account_number_last4") @db.VarChar(4)
  accountHolderName  String    @map("account_holder_name")
  isPrimary          Boolean   @default(false) @map("is_primary")
  isVerified         Boolean   @default(false) @map("is_verified")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@index([venueId])
  @@map("venue_bank_accounts")
}

model MemberBranchAccess {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId String @map("member_id")
  branchId String @map("branch_id") @db.Uuid

  canViewSchedule   Boolean @default(true) @map("can_view_schedule")
  canManageBookings Boolean @default(false) @map("can_manage_bookings")
  canScanCheckIn    Boolean @default(false) @map("can_scan_check_in")
  canViewFinance    Boolean @default(false) @map("can_view_finance")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branch VenueBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([memberId, branchId])
  @@index([branchId])
  @@map("member_branch_access")
}

// ------------------------------------------------------------
// 5. Court, Schedule, Pricing
// ------------------------------------------------------------

model Court {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId  String @map("venue_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  sportId  String @map("sport_id") @db.Uuid

  name                String
  description         String?
  courtType           String?        @map("court_type")
  surfaceType         String?        @map("surface_type")
  indoorOutdoor       IndoorOutdoor? @map("indoor_outdoor")
  basePriceAmount     BigInt         @map("base_price_amount")
  slotDurationMinutes Int            @default(60) @map("slot_duration_minutes")
  status              CourtStatus    @default(active)
  sortOrder           Int            @default(0) @map("sort_order")
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue  Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  branch VenueBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sport  Sport       @relation(fields: [sportId], references: [id])

  photos             CourtPhoto[]
  operatingHours     CourtOperatingHour[]
  priceRules         CourtPriceRule[]
  availabilityBlocks CourtAvailabilityBlock[]
  bookingSlots       BookingSlot[]

  @@index([venueId])
  @@index([branchId])
  @@index([sportId])
  @@index([status])
  @@index([basePriceAmount])
  @@map("courts")
}

model CourtPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId])
  @@map("court_photos")
}

model CourtOperatingHour {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courtId   String    @map("court_id") @db.Uuid
  dayOfWeek Int       @map("day_of_week") // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime  DateTime? @map("open_time") @db.Time(6)
  closeTime DateTime? @map("close_time") @db.Time(6)
  isClosed  Boolean   @default(false) @map("is_closed")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, dayOfWeek])
  @@index([courtId])
  @@map("court_operating_hours")
}

model CourtPriceRule {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courtId     String        @map("court_id") @db.Uuid
  name        String
  ruleType    PriceRuleType @map("rule_type")
  // Lower number = higher priority. Example: peak_hour priority 10 overrides weekend priority 50.
  priority    Int           @default(100)
  dayOfWeek   Int?          @map("day_of_week")
  startTime   DateTime?     @map("start_time") @db.Time(6)
  endTime     DateTime?     @map("end_time") @db.Time(6)
  validFrom   DateTime?     @map("valid_from") @db.Date
  validUntil  DateTime?     @map("valid_until") @db.Date
  priceAmount BigInt        @map("price_amount")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  court        Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  bookingSlots BookingSlot[]

  @@index([courtId])
  @@index([isActive])
  @@index([courtId, dayOfWeek, startTime, endTime, priority])
  @@map("court_price_rules")
}

model CourtAvailabilityBlock {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courtId         String                  @map("court_id") @db.Uuid
  createdByUserId String                  @map("created_by_user_id")
  startsAt        DateTime                @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime                @map("ends_at") @db.Timestamptz(6)
  // PostgreSQL generated range column untuk anti-overlap availability block.
  // Dibuat/diubah lewat raw SQL migration.
  timeRange       Unsupported("tstzrange")? @default(dbgenerated()) @map("time_range")
  reason          String?
  blockType       AvailabilityBlockType   @default(maintenance) @map("block_type")
  status          AvailabilityBlockStatus @default(active)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  court     Court @relation(fields: [courtId], references: [id], onDelete: Cascade)
  createdBy User  @relation("AvailabilityBlockCreatedBy", fields: [createdByUserId], references: [id])

  @@index([courtId, startsAt, endsAt])
  @@index([status])
  @@map("court_availability_blocks")
}

// ------------------------------------------------------------
// 6. Booking
// ------------------------------------------------------------

model Booking {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingCode    String  @unique @map("booking_code")
  customerUserId String? @map("customer_user_id")
  venueId        String  @map("venue_id") @db.Uuid
  branchId       String  @map("branch_id") @db.Uuid

  // Customer snapshot untuk booking manual/walk-in (saat customerUserId null).
  // Field eksplisit lebih disarankan daripada JSON untuk kebutuhan operasional staff.
  customerName  String? @map("customer_name")
  customerPhone String? @map("customer_phone")
  customerEmail String? @map("customer_email")

  source        BookingSource        @default(online)
  status        BookingStatus        @default(pending_payment)
  paymentStatus BookingPaymentStatus @default(unpaid) @map("payment_status")

  currency                 String @default("IDR")
  subtotalAmount           BigInt @default(0) @map("subtotal_amount")
  platformFeeAmount        BigInt @default(0) @map("platform_fee_amount")
  discountAmount           BigInt @default(0) @map("discount_amount")
  totalAmount              BigInt @default(0) @map("total_amount")
  platformCommissionBps    Int    @default(0) @map("platform_commission_bps")
  platformCommissionAmount BigInt @default(0) @map("platform_commission_amount")
  venueNetAmount           BigInt @default(0) @map("venue_net_amount")

  customerNotes              String? @map("customer_notes")
  internalNotes              String? @map("internal_notes")
  cancellationPolicySnapshot Json?   @map("cancellation_policy_snapshot")

  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6)
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId  String?   @map("cancelled_by_user_id")
  cancellationReason String?   @map("cancellation_reason")
  createdByUserId    String?   @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer    User?       @relation("CustomerBookings", fields: [customerUserId], references: [id])
  venue       Venue       @relation(fields: [venueId], references: [id])
  branch      VenueBranch @relation(fields: [branchId], references: [id])
  cancelledBy User?       @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id])
  createdBy   User?       @relation("BookingCreatedBy", fields: [createdByUserId], references: [id])

  slots            BookingSlot[]
  cancellations    BookingCancellation[]
  checkIns         BookingCheckIn[]
  payments         Payment[]
  refunds          Refund[]
  ledgerEntries    VenueLedgerEntry[]
  invoice          Invoice?
  reviews          Review[]
  notificationLogs NotificationLog[]
  reminders        BookingReminder[]
  webhookEvents    PaymentWebhookEvent[]

  @@index([customerUserId])
  @@index([venueId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerUserId, status, createdAt])
  @@map("bookings")
}

model BookingSlot {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  courtId   String @map("court_id") @db.Uuid

  // Absolute timestamp. Simpan UTC di timestamptz.
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  // Snapshot local time venue untuk invoice, history, reminder, dan audit timezone.
  venueTimezone  String   @map("venue_timezone")
  localDate      DateTime @map("local_date") @db.Date
  localStartTime DateTime @map("local_start_time") @db.Time(6)
  localEndTime   DateTime @map("local_end_time") @db.Time(6)

  // PostgreSQL generated range column untuk anti-overlap.
  // Dibuat/diubah lewat raw SQL migration.
  timeRange Unsupported("tstzrange")? @default(dbgenerated()) @map("time_range")

  durationMinutes Int               @map("duration_minutes")
  priceAmount     BigInt            @map("price_amount")
  priceRuleId     String?           @map("price_rule_id") @db.Uuid
  priceSnapshot   Json?             @map("price_snapshot")
  status          BookingSlotStatus @default(pending)
  checkedInAt     DateTime?         @map("checked_in_at") @db.Timestamptz(6)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz(6)
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking   Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court     Court           @relation(fields: [courtId], references: [id])
  priceRule CourtPriceRule? @relation(fields: [priceRuleId], references: [id])

  checkIns     BookingCheckIn[]
  invoiceItems InvoiceItem[]

  @@index([bookingId])
  @@index([courtId])
  @@index([startsAt, endsAt])
  @@index([localDate, localStartTime])
  @@index([status])
  @@map("booking_slots")
}

model BookingCancellation {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String                @map("booking_id") @db.Uuid
  requestedByUserId String?               @map("requested_by_user_id")
  actorType         CancellationActorType @map("actor_type")
  reason            String?
  // Default processed karena MVP tidak punya approval flow pembatalan manual.
  // Ubah default ke requested jika nanti cancellation perlu direview admin/venue.
  status            CancellationStatus    @default(processed)
  refundAmount      BigInt                @default(0) @map("refund_amount")
  penaltyAmount     BigInt                @default(0) @map("penalty_amount")
  policySnapshot    Json?                 @map("policy_snapshot")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt       DateTime?             @map("processed_at") @db.Timestamptz(6)

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation("BookingCancellationRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([bookingId])
  @@index([actorType])
  @@map("booking_cancellations")
}

model BookingCheckIn {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  bookingSlotId     String?       @map("booking_slot_id") @db.Uuid
  customerUserId    String?       @map("customer_user_id")
  checkedInByUserId String?       @map("checked_in_by_user_id")
  method            CheckInMethod @default(manual)
  qrTokenHash       String?       @map("qr_token_hash")
  checkedInAt       DateTime      @default(now()) @map("checked_in_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingSlot BookingSlot? @relation(fields: [bookingSlotId], references: [id], onDelete: Cascade)
  customer    User?        @relation("CheckInCustomer", fields: [customerUserId], references: [id])
  checkedInBy User?        @relation("CheckInStaff", fields: [checkedInByUserId], references: [id])

  @@index([bookingId])
  @@index([bookingSlotId])
  @@index([checkedInByUserId])
  @@map("booking_check_ins")
}

// ------------------------------------------------------------
// 7. Payment, Xendit Webhook, Refund
// ------------------------------------------------------------

model Payment {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String         @map("booking_id") @db.Uuid
  customerUserId   String?        @map("customer_user_id")
  gateway          PaymentGateway @default(xendit)
  externalId       String         @unique @map("external_id")
  gatewayInvoiceId String?        @map("gateway_invoice_id")
  gatewayPaymentId String?        @map("gateway_payment_id")
  paymentMethod    PaymentMethod? @map("payment_method")
  paymentChannel   String?        @map("payment_channel")
  currency         String         @default("IDR")
  amount           BigInt
  gatewayFeeAmount BigInt         @default(0) @map("gateway_fee_amount")
  status           PaymentStatus  @default(pending)
  invoiceUrl       String?        @map("invoice_url")
  checkoutUrl      String?        @map("checkout_url")
  paidAt           DateTime?      @map("paid_at") @db.Timestamptz(6)
  expiredAt        DateTime?      @map("expired_at") @db.Timestamptz(6)
  failedAt         DateTime?      @map("failed_at") @db.Timestamptz(6)
  failureReason    String?        @map("failure_reason")
  rawRequest       Json?          @map("raw_request")
  rawResponse      Json?          @map("raw_response")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User?   @relation("PaymentCustomer", fields: [customerUserId], references: [id])

  webhookEvents    PaymentWebhookEvent[]
  refunds          Refund[]
  ledgerEntries    VenueLedgerEntry[]
  invoices         Invoice[]
  notificationLogs NotificationLog[]

  @@index([bookingId])
  @@index([customerUserId])
  @@index([status])
  @@index([gatewayInvoiceId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gateway          String                  @default("xendit")
  eventType        String                  @map("event_type")
  eventId          String?                 @map("event_id")
  externalId       String?                 @map("external_id")
  idempotencyKey   String                  @unique(map: "uq_payment_webhook_idempotency_key") @map("idempotency_key")
  paymentId        String?                 @map("payment_id") @db.Uuid
  bookingId        String?                 @map("booking_id") @db.Uuid
  payload          Json
  processingStatus WebhookProcessingStatus @default(pending) @map("processing_status")
  processedAt      DateTime?               @map("processed_at") @db.Timestamptz(6)
  errorMessage     String?                 @map("error_message")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@unique([gateway, eventId])
  @@index([externalId])
  @@index([bookingId])
  @@index([processingStatus])
  @@map("payment_webhook_events")
}

model Refund {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String         @map("booking_id") @db.Uuid
  paymentId         String         @map("payment_id") @db.Uuid
  customerUserId    String?        @map("customer_user_id")
  gateway           PaymentGateway @default(xendit)
  gatewayRefundId   String?        @map("gateway_refund_id")
  externalRefundId  String         @unique @map("external_refund_id")
  currency          String         @default("IDR")
  amount            BigInt
  reason            String?
  policySnapshot    Json?          @map("policy_snapshot")
  status            RefundStatus   @default(pending)
  requestedByUserId String?        @map("requested_by_user_id")
  processedAt       DateTime?      @map("processed_at") @db.Timestamptz(6)
  failedAt          DateTime?      @map("failed_at") @db.Timestamptz(6)
  failureReason     String?        @map("failure_reason")
  rawRequest        Json?          @map("raw_request")
  rawResponse       Json?          @map("raw_response")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking     Booking @relation(fields: [bookingId], references: [id])
  payment     Payment @relation(fields: [paymentId], references: [id])
  customer    User?   @relation("RefundCustomer", fields: [customerUserId], references: [id])
  requestedBy User?   @relation("RefundRequestedBy", fields: [requestedByUserId], references: [id])

  ledgerEntries    VenueLedgerEntry[]
  notificationLogs NotificationLog[]

  @@index([bookingId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

// ------------------------------------------------------------
// 8. Finance, Ledger, Withdraw
// ------------------------------------------------------------

model VenueLedgerEntry {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId        String            @map("venue_id") @db.Uuid
  branchId       String?           @map("branch_id") @db.Uuid
  bookingId      String?           @map("booking_id") @db.Uuid
  paymentId      String?           @map("payment_id") @db.Uuid
  refundId       String?           @map("refund_id") @db.Uuid
  withdrawalId   String?           @map("withdrawal_id") @db.Uuid
  idempotencyKey String            @unique(map: "uq_venue_ledger_entry_idempotency_key") @map("idempotency_key")
  entryType      LedgerEntryType   @map("entry_type")
  currency       String            @default("IDR")
  amountDelta    BigInt            @map("amount_delta")
  status         LedgerEntryStatus @default(pending)
  availableAt    DateTime?         @map("available_at") @db.Timestamptz(6)
  description    String?
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  venue      Venue        @relation(fields: [venueId], references: [id])
  branch     VenueBranch? @relation(fields: [branchId], references: [id])
  booking    Booking?     @relation(fields: [bookingId], references: [id])
  payment    Payment?     @relation(fields: [paymentId], references: [id])
  refund     Refund?      @relation(fields: [refundId], references: [id])
  withdrawal Withdrawal?  @relation(fields: [withdrawalId], references: [id])

  withdrawalLedgerEntries WithdrawalLedgerEntry[]

  @@index([venueId])
  @@index([branchId])
  @@index([bookingId])
  @@index([status])
  @@index([availableAt])
  @@map("venue_ledger_entries")
}

model Withdrawal {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId               String           @map("venue_id") @db.Uuid
  bankAccountId         String           @map("bank_account_id") @db.Uuid
  requestedByUserId     String           @map("requested_by_user_id")
  processedByUserId     String?          @map("processed_by_user_id")
  currency              String           @default("IDR")
  amount                BigInt
  feeAmount             BigInt           @default(0) @map("fee_amount")
  netAmount             BigInt           @map("net_amount")
  status                WithdrawalStatus @default(requested)
  gateway               PaymentGateway   @default(xendit)
  gatewayDisbursementId String?          @map("gateway_disbursement_id")
  externalId            String?          @unique @map("external_id")
  requestedAt           DateTime         @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt            DateTime?        @map("approved_at") @db.Timestamptz(6)
  processedAt           DateTime?        @map("processed_at") @db.Timestamptz(6)
  paidAt                DateTime?        @map("paid_at") @db.Timestamptz(6)
  rejectedAt            DateTime?        @map("rejected_at") @db.Timestamptz(6)
  failedAt              DateTime?        @map("failed_at") @db.Timestamptz(6)
  rejectionReason       String?          @map("rejection_reason")
  failureReason         String?          @map("failure_reason")
  rawRequest            Json?            @map("raw_request")
  rawResponse           Json?            @map("raw_response")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue       Venue            @relation(fields: [venueId], references: [id])
  bankAccount VenueBankAccount @relation(fields: [bankAccountId], references: [id])
  requestedBy User             @relation("WithdrawalRequestedBy", fields: [requestedByUserId], references: [id])
  processedBy User?            @relation("WithdrawalProcessedBy", fields: [processedByUserId], references: [id])

  ledgerEntries           VenueLedgerEntry[]
  withdrawalLedgerEntries WithdrawalLedgerEntry[]
  notificationLogs        NotificationLog[]

  @@index([venueId])
  @@index([status])
  @@index([requestedAt])
  @@map("withdrawals")
}

model WithdrawalLedgerEntry {
  withdrawalId  String   @map("withdrawal_id") @db.Uuid
  ledgerEntryId String   @map("ledger_entry_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  withdrawal  Withdrawal       @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  ledgerEntry VenueLedgerEntry @relation(fields: [ledgerEntryId], references: [id])

  @@id([withdrawalId, ledgerEntryId])
  @@index([ledgerEntryId])
  @@map("withdrawal_ledger_entries")
}

// ------------------------------------------------------------
// 9. Invoice & Receipt PDF
// ------------------------------------------------------------

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String        @unique @map("booking_id") @db.Uuid
  paymentId      String?       @map("payment_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number")
  customerUserId String?       @map("customer_user_id")
  venueId        String        @map("venue_id") @db.Uuid
  currency       String        @default("IDR")
  subtotalAmount BigInt        @map("subtotal_amount")
  discountAmount BigInt        @default(0) @map("discount_amount")
  totalAmount    BigInt        @map("total_amount")
  status         InvoiceStatus @default(issued)
  pdfUrl         String?       @map("pdf_url")
  issuedAt       DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id])
  customer User?    @relation("InvoiceCustomer", fields: [customerUserId], references: [id])
  venue    Venue    @relation(fields: [venueId], references: [id])

  items InvoiceItem[]

  @@index([bookingId])
  @@index([venueId])
  @@index([customerUserId])
  @@map("invoices")
}

model InvoiceItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId     String   @map("invoice_id") @db.Uuid
  bookingSlotId String?  @map("booking_slot_id") @db.Uuid
  description   String
  quantity      Int      @default(1)
  unitAmount    BigInt   @map("unit_amount")
  totalAmount   BigInt   @map("total_amount")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bookingSlot BookingSlot? @relation(fields: [bookingSlotId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

// ------------------------------------------------------------
// 10. Review & Rating
// ------------------------------------------------------------

model Review {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId      String       @map("booking_id") @db.Uuid
  customerUserId String       @map("customer_user_id")
  venueId        String       @map("venue_id") @db.Uuid
  branchId       String?      @map("branch_id") @db.Uuid
  rating         Int
  reviewText     String?      @map("review_text")
  status         ReviewStatus @default(published)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  hiddenAt       DateTime?    @map("hidden_at") @db.Timestamptz(6)
  hiddenByUserId String?      @map("hidden_by_user_id")
  hideReason     String?      @map("hide_reason")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking  Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User         @relation("ReviewCustomer", fields: [customerUserId], references: [id])
  venue    Venue        @relation(fields: [venueId], references: [id])
  branch   VenueBranch? @relation(fields: [branchId], references: [id])
  hiddenBy User?        @relation("ReviewHiddenBy", fields: [hiddenByUserId], references: [id])

  @@unique([bookingId, customerUserId])
  @@index([venueId])
  @@index([customerUserId])
  @@index([rating])
  @@index([status])
  @@map("reviews")
}

// ------------------------------------------------------------
// 11. Notification Logs & Reminders
// ------------------------------------------------------------

model NotificationLog {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?             @map("user_id")
  bookingId         String?             @map("booking_id") @db.Uuid
  paymentId         String?             @map("payment_id") @db.Uuid
  refundId          String?             @map("refund_id") @db.Uuid
  withdrawalId      String?             @map("withdrawal_id") @db.Uuid
  channel           NotificationChannel
  notificationType  NotificationType    @map("notification_type")
  recipient         String
  subject           String?
  message           String?
  provider          String?
  providerMessageId String?             @map("provider_message_id")
  status            NotificationStatus  @default(pending)
  scheduledAt       DateTime?           @map("scheduled_at") @db.Timestamptz(6)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)
  failedAt          DateTime?           @map("failed_at") @db.Timestamptz(6)
  errorMessage      String?             @map("error_message")
  payload           Json?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User?       @relation("NotificationUser", fields: [userId], references: [id])
  booking    Booking?    @relation(fields: [bookingId], references: [id])
  payment    Payment?    @relation(fields: [paymentId], references: [id])
  refund     Refund?     @relation(fields: [refundId], references: [id])
  withdrawal Withdrawal? @relation(fields: [withdrawalId], references: [id])

  bookingReminders BookingReminder[]

  @@index([userId])
  @@index([bookingId])
  @@index([channel])
  @@index([notificationType])
  @@index([status])
  @@index([scheduledAt])
  @@map("notification_logs")
}

model BookingReminder {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String              @map("booking_id") @db.Uuid
  customerUserId    String?             @map("customer_user_id")
  channel           NotificationChannel
  reminderType      ReminderType        @default(before_booking) @map("reminder_type")
  scheduledAt       DateTime            @map("scheduled_at") @db.Timestamptz(6)
  status            ReminderStatus      @default(scheduled)
  notificationLogId String?             @map("notification_log_id") @db.Uuid
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)
  failedAt          DateTime?           @map("failed_at") @db.Timestamptz(6)
  errorMessage      String?             @map("error_message")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking         Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer        User?            @relation("ReminderCustomer", fields: [customerUserId], references: [id])
  notificationLog NotificationLog? @relation(fields: [notificationLogId], references: [id])

  @@index([bookingId])
  @@index([scheduledAt])
  @@index([status])
  @@map("booking_reminders")
}

// ------------------------------------------------------------
// 12. Admin, Moderation, Platform Settings
// ------------------------------------------------------------

model VenueApprovalRequest {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId           String                @map("venue_id") @db.Uuid
  submittedByUserId String                @map("submitted_by_user_id")
  reviewedByUserId  String?               @map("reviewed_by_user_id")
  status            ApprovalRequestStatus @default(pending)
  submissionNotes   String?               @map("submission_notes")
  reviewNotes       String?               @map("review_notes")
  submittedAt       DateTime              @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt        DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue       Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
